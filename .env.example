# meetingsdk-appointment-sample-js
#
#   cp .env.example .env
#
# NOT PRODUCTION READY. Environment files are fine for local development. In
# production load these from a secrets manager. See the README.

# ─── Meeting SDK credentials ────────────────────────────────────────────────
# Create a Meeting SDK app at https://marketplace.zoom.us:
#   Develop > Build App > Meeting SDK
#
# The KEY is public. It is returned to the browser alongside the signature.
ZOOM_MEETING_SDK_KEY=YOUR_MEETING_SDK_KEY_HERE

# The SECRET is not. It signs the signature JWT and must never reach the
# browser, a log line, or a commit. Anyone holding it can join any meeting on
# your account as host.
ZOOM_MEETING_SDK_SECRET=YOUR_MEETING_SDK_SECRET_HERE

# ─── Application ────────────────────────────────────────────────────────────
PORT=3000
